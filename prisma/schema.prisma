generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  decks      Deck[]
  reviewLogs ReviewLog[]

  @@map("user_profiles")
}

model Deck {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([userId])
  @@map("decks")
}

model Card {
  id           String   @id @default(uuid())
  deckId       String   @map("deck_id")
  frontContent String   @map("front_content")
  backContent  String   @map("back_content")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deck        Deck             @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviewState CardReviewState?

  @@index([deckId])
  @@map("cards")
}

model CardReviewState {
  cardId String @id @map("card_id")
  userId String @map("user_id")

  interval       Int       @default(0) // days until next review
  repetition     Int       @default(0) // consecutive correct review count
  easeFactor     Float     @default(2.5) @map("ease_factor") // difficulty multiplier (min 1.3)
  dueDate        DateTime  @default(now()) @map("due_date")
  lastReviewedAt DateTime? @map("last_reviewed_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@map("card_review_states")
}

model ReviewLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  cardId     String   @map("card_id")
  rating     Int // 1: Again, 2: Hard, 3: Good, 4: Easy
  reviewedAt DateTime @default(now()) @map("reviewed_at")

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("review_logs")
}
